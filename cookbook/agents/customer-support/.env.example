# OpenEight Agent settings. Copy to .env; never commit real credentials.
OPENEIGHT_ENDPOINT=https://<your-openeight-api-host>
OPENEIGHT_AGENT_NAME=<your-agent-name>
OPENEIGHT_API_KEY=<your-agent-api-key>

# Optional Console origin for approval and Run links; defaults to the API origin.
# OPENEIGHT_CONSOLE_ORIGIN=https://<your-openeight-console-host>

# Explicit model settings (incident scripted mode does not need them).
AGENT_MODEL=<provider>:<model>
AGENT_MODEL_API_KEY=<your-model-provider-api-key>
